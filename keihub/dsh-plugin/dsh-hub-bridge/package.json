{
  "name": "dsh-hub-bridge",
  "version": "0.1.0",
  "description": "KeiHub ↔ DSH 极薄连接件：只把 Hub 的入站消息交给 agent.followup，再把回复回传 Hub。",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "fatfish",
    "onebot",
    "snowluma"
  ],
